        <TextBox x:Name="Stock_Quantity_Textbox" HorizontalAlignment="Left" Margin="88,160,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="183" FontSize="25"/>
        <TextBox x:Name="Current_Price_Textbox" HorizontalAlignment="Left" Margin="88,296,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="183" FontSize="25"/>
        <Button x:Name="Click_to_Update_2_Button" Content="Click To Update" HorizontalAlignment="Left" Margin="503,195,0,0" VerticalAlignment="Top" Height="82" Width="201" FontSize="25" Click="Click_to_Update_2_Button_Click"/>
