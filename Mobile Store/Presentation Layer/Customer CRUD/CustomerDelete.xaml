<Window x:Class="Presentation_Layer.Customer_CRUD.CustomerDelete"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Presentation_Layer.Customer_CRUD"
        mc:Ignorable="d"
        Title="CustomerDelete" Height="450" Width="800">
    <Grid>
        <Label x:Name="remove_customer_Label" Content="Remove Customer" HorizontalAlignment="Left" Margin="275,31,0,0" VerticalAlignment="Top" Width="266" Height="63" FontSize="30" Background="#FFF86AC2"/>
        <Label x:Name="first_name_label" Content="First Name" HorizontalAlignment="Left" Margin="77,100,0,0" VerticalAlignment="Top" Width="184" Height="50" FontSize="30"/>
        <Label x:Name="last_name_Label" Content="Last Name" HorizontalAlignment="Left" Margin="71,206,0,0" VerticalAlignment="Top" Width="168" Height="47" FontSize="30"/>
        <Label x:Name="phone_number_Label" Content="Phone Number" HorizontalAlignment="Left" Margin="73,304,0,0" VerticalAlignment="Top" Width="228" Height="48" FontSize="30"/>
        <TextBox x:Name="first_name_Textbox" HorizontalAlignment="Left" Margin="73,155,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="224" FontSize="25"/>
        <TextBox x:Name="last_name_Textbox" HorizontalAlignment="Left" Margin="73,255,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="224" FontSize="25"/>
        <TextBox x:Name="phone_number_Textbox" HorizontalAlignment="Left" Margin="71,354,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="224" FontSize="25"/>
        <Button x:Name="click_here_to_remove_Button" Content="Click here to Remove" HorizontalAlignment="Left" Margin="448,189,0,0" VerticalAlignment="Top" Height="75" Width="308" FontSize="30" Click="click_here_to_remove_Button_Click"/>

    </Grid>
</Window>
