<Window x:Class="Presentation_Layer.Customer_CRUD.CustomerAdd"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Presentation_Layer.Customer_CRUD"
        mc:Ignorable="d"
        Title="CustomerAdd" Height="450" Width="800">
    <Grid>
        <Label x:Name="Add_Customer_Label" Content="Add Customer" HorizontalAlignment="Left" Margin="292,37,0,0" VerticalAlignment="Top" Width="205" Height="55" FontSize="30" Background="#FF28F2CC"/>
        <Label x:Name="first_name_Label" Content="First Name" HorizontalAlignment="Left" Margin="64,112,0,0" VerticalAlignment="Top" Width="148" Height="42" FontSize="25"/>
        <Label x:Name="last_name_Label" Content="Last Name" HorizontalAlignment="Left" Margin="59,215,0,0" VerticalAlignment="Top" Width="139" Height="52" FontSize="25"/>
        <Label x:Name="age_Label" Content="Age" HorizontalAlignment="Left" Margin="61,319,0,0" VerticalAlignment="Top" Width="131" Height="50" FontSize="25"/>
        <Label x:Name="phone_number_Label" Content="Phone Number" HorizontalAlignment="Left" Margin="432,114,0,0" VerticalAlignment="Top" FontSize="25"/>
        <Label x:Name="address_Label" Content="Address" HorizontalAlignment="Left" Margin="439,222,0,0" VerticalAlignment="Top" FontSize="25"/>
        <TextBox x:Name="first_name_Textbox" HorizontalAlignment="Left" Margin="58,159,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="205" FontSize="25"/>
        <TextBox x:Name="last_name_Textbox" HorizontalAlignment="Left" Margin="58,267,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="205" FontSize="25"/>
        <TextBox x:Name="age_Textbox" HorizontalAlignment="Left" Margin="59,368,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="120" FontSize="25"/>
        <TextBox x:Name="phone_number_Textbox" HorizontalAlignment="Left" Margin="430,162,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="202" FontSize="25"/>
        <TextBox x:Name="address_Textbox" HorizontalAlignment="Left" Margin="435,269,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="306" FontSize="25" Height="52"/>
        <Button x:Name="click_here_to_add_Button" Content="Click here to Add" HorizontalAlignment="Left" Margin="439,344,0,0" VerticalAlignment="Top" Width="230" Height="59" FontSize="25" Click="click_here_to_add_Button_Click"/>

    </Grid>
</Window>
