        <Label x:Name="last_name_Label" Content="Last Name" HorizontalAlignment="Left" Margin="66,218,0,0" VerticalAlignment="Top" FontSize="30"/>
        <Label x:Name="age_Label" Content="Age" HorizontalAlignment="Left" Margin="67,311,0,0" VerticalAlignment="Top" FontSize="30"/>
        <Label x:Name="phone_number_Label" Content="Phone Number" HorizontalAlignment="Left" Margin="416,125,0,0" VerticalAlignment="Top" FontSize="30"/>
