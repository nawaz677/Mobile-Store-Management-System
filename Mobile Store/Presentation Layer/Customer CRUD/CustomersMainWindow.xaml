<Window x:Class="Presentation_Layer.Customer_CRUD.CustomersMainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Presentation_Layer.Customer_CRUD"
        mc:Ignorable="d"
        Title="CustomersMainWindow" Height="450" Width="800">
    <Grid>
        <Label x:Name="Customer_Management_Label" Content="Customer Management" HorizontalAlignment="Left" Margin="235,41,0,0" VerticalAlignment="Top" Width="323" Height="65" FontSize="30" Background="#FF5AFE5C"/>
        <Button x:Name="View_Customers_Button" Content="View Customers" HorizontalAlignment="Left" Margin="470,135,0,0" VerticalAlignment="Top" Height="95" Width="263" FontSize="30" Click="View_Customers_Button_Click" Background="#FFF48A8A"/>
        <Button x:Name="Add_Customer_Button" Content="Add Customer" HorizontalAlignment="Left" Margin="52,135,0,0" VerticalAlignment="Top" Width="260" Height="95" FontSize="30" Click="Add_Customer_Button_Click" Background="#FFF3AF6C"/>
        <Button x:Name="delete_customer_button" Content="Delete Customer" HorizontalAlignment="Left" Margin="470,277,0,0" VerticalAlignment="Top" Height="98" Width="262" FontSize="30" Click="delete_customer_button_Click" Background="#FFBC9BFF"/>
        <Button x:Name="Update_Customer_Button" Content="Update Customer" HorizontalAlignment="Left" Margin="55,277,0,0" VerticalAlignment="Top" Height="98" Width="260" FontSize="30" Click="Update_Customer_Button_Click" Background="#FF55D6CE"/>

    </Grid>
</Window>
