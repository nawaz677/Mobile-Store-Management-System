<Window x:Class="Presentation_Layer.Customer_CRUD.CustomerUpdate"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Presentation_Layer.Customer_CRUD"
        mc:Ignorable="d"
        Title="CustomerUpdate" Height="450" Width="800">
    <Grid>
        <Label Content="Label" HorizontalAlignment="Left" Margin="888,103,0,0" VerticalAlignment="Top"/>
        <Label x:Name="update_customer_Label" Content="Update Customer" HorizontalAlignment="Left" Margin="264,27,0,0" VerticalAlignment="Top" Width="292" Height="62" FontSize="35" Background="#FFEF885A"/>
        <Label x:Name="first_name_Label" Content="First Name" HorizontalAlignment="Left" Margin="70,99,0,0" VerticalAlignment="Top" Width="187" Height="43" FontSize="30"/>
        <Label x:Name="last_name_Label" Content="Last Name" HorizontalAlignment="Left" Margin="78,206,0,0" VerticalAlignment="Top" Width="180" Height="54" FontSize="30"/>
        <Label x:Name="phone_number_Label" Content="Phone Number" HorizontalAlignment="Left" Margin="72,306,0,0" VerticalAlignment="Top" Width="216" Height="44" FontSize="30"/>
        <TextBox x:Name="first_name_Textbox" HorizontalAlignment="Left" Margin="78,157,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="210" FontSize="25"/>
        <TextBox x:Name="last_name_Textbox" HorizontalAlignment="Left" Margin="81,259,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="207" FontSize="25"/>
        <TextBox x:Name="phone_number_Textbox" HorizontalAlignment="Left" Margin="80,359,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="208" FontSize="25"/>
        <Button x:Name="click_to_proceed_Button" Content="Click to Proceed" HorizontalAlignment="Left" Margin="486,199,0,0" VerticalAlignment="Top" Height="75" Width="237" FontSize="30" Click="click_to_proceed_Button_Click"/>

