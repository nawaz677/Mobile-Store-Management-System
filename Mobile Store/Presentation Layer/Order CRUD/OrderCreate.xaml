<Window x:Class="Presentation_Layer.Order_CRUD.OrderCreate"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Presentation_Layer.Order_CRUD"
        mc:Ignorable="d"
        Title="OrderCreate" Height="500" Width="900">
    <Grid>
        <Label x:Name="Create_Order_Label" Content="Create Order" HorizontalAlignment="Left" Margin="336,14,0,0" VerticalAlignment="Top" Width="217" Height="68" FontSize="35" Background="#FFB0E959"/>
        <ComboBox x:Name="Products_ComboBox" HorizontalAlignment="Left" Margin="34,161,0,0" VerticalAlignment="Top" Width="362" Height="42" FontSize="25" SelectionChanged="Products_ComboBox_SelectionChanged" />
        <ComboBox x:Name="Customers_ComboBox" HorizontalAlignment="Left" Margin="479,159,0,0" VerticalAlignment="Top" Width="379" Height="44" FontSize="25"/>
        <TextBox x:Name="Quantity_Textbox" TextChanged="Quantity_Textbox_TextChanged" HorizontalAlignment="Left" Margin="34,301,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="159" Height="43" FontSize="25"/>
        <Label x:Name="Quantity_Label" Content="Quantity" HorizontalAlignment="Left" Margin="37,255,0,0" VerticalAlignment="Top" Width="128" Height="47" FontSize="30"/>
        <Label x:Name="Unit_Price_Label" Content="Unit Price" HorizontalAlignment="Left" Margin="258,254,0,0" VerticalAlignment="Top" Height="44" Width="141" FontSize="30"/>
        <TextBox x:Name="Unit_Price_Textbox" TextChanged="Unit_Price_TextChanged" HorizontalAlignment="Left" Margin="258,303,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="216" Height="41" FontSize="25"/>
        <TextBox x:Name="Total_Amount_Textbox" HorizontalAlignment="Left" Margin="533,303,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="209" Height="41" FontSize="25" IsReadOnly="True" IsReadOnlyCaretVisible="True"/>
        <Label x:Name="Total_Amount_Label" Content="Total Amount" HorizontalAlignment="Left" Margin="527,252,0,0" VerticalAlignment="Top" Height="46" Width="197" FontSize="30"/>
        <Label x:Name="Product_Label" Content="Products" HorizontalAlignment="Left" Margin="39,104,0,0" VerticalAlignment="Top" FontSize="30"/>
        <Label x:Name="Customers_Label" Content="Customers" HorizontalAlignment="Left" Margin="483,104,0,0" VerticalAlignment="Top" FontSize="30" Width="164"/>
        <Button x:Name="Place_Order_Button" Content="Place Order" HorizontalAlignment="Left" Margin="512,382,0,0" VerticalAlignment="Top" Height="77" Width="285" FontSize="30" Background="#FFFF5454" Click="Place_Order_Button_Click"/>

    </Grid>
</Window>
